---
import { zonedTimeToUtc, formatUtcStamp, DEFAULT_TIMEZONE, DEFAULT_EVENT_DURATION_MS } from "../lib/ics";
import { extractBitEventId, BIT_ARTIST_NAME } from "../lib/bandsintown";

interface Props {
  id?: string;
  title: string;
  date: Date;
  venue: string;
  city: string;
  ticketUrl?: string;
  isSoldOut?: boolean;
  isPast?: boolean;
  startTime?: string | null;
  timezone?: string | null;
  bandsintownUrl?: string | null;
}

const {
  id,
  title,
  date,
  venue,
  city,
  ticketUrl,
  isSoldOut = false,
  isPast = false,
  startTime,
  timezone,
  bandsintownUrl,
} = Astro.props;

// WEB-03/D-07: scoping por evento. Fail-closed — sin ID numerico extraible
// no se emite el widget (evita el fallback de BIT a "listar todos los shows").
const bitEventId = bandsintownUrl ? extractBitEventId(bandsintownUrl) : null;

// Format date
const formattedDate = date.toLocaleDateString("es-ES", {
  day: "numeric",
  month: "short",
  year: "numeric",
});

const dayNumber = date.getDate();
const monthName = date.toLocaleDateString("es-ES", { month: "short" }).toUpperCase();

// Google Calendar "create event" link (template method, undocumented but
// stable — see calendar-link's google() implementation on GitHub).
const pad2 = (n: number) => String(n).padStart(2, "0");
const toYYYYMMDD = (d: Date) => `${d.getUTCFullYear()}${pad2(d.getUTCMonth() + 1)}${pad2(d.getUTCDate())}`;

const trimmedStartTime = startTime?.slice(0, 5) ?? "";
const hasStartTime = /^\d{2}:\d{2}$/.test(trimmedStartTime);

let gcalDates: string;
if (hasStartTime) {
  // Timed event. `date` (from conciertos.astro) is UTC-midnight for this
  // calendar day; take just the YYYY-MM-DD part and combine with the
  // wall-clock startTime in the concert's own timezone, converted to a real
  // UTC instant (same helper the .ics generator uses, so both paths agree).
  // Google's TEMPLATE URL accepts `dates=<start>Z/<end>Z` in UTC — no `ctz`
  // param needed, since a Z-suffixed UTC instant renders correctly in each
  // viewer's own Google Calendar timezone automatically (the same behavior
  // any UTC-timed .ics VEVENT gets).
  const datePart = toYYYYMMDD(date).replace(/^(\d{4})(\d{2})(\d{2})$/, "$1-$2-$3");
  const tz = timezone || DEFAULT_TIMEZONE;
  const start = zonedTimeToUtc(datePart, trimmedStartTime, tz);
  const end = new Date(start.getTime() + DEFAULT_EVENT_DURATION_MS);
  gcalDates = formatUtcStamp(start) + "/" + formatUtcStamp(end);
} else {
  // No start time on record: all-day event. `dates` is START/END in
  // YYYYMMDD, and Google treats END as EXCLUSIVE: it must be the day AFTER
  // the show, or the event lands a day short / on the wrong day for anyone
  // whose calendar app renders all-day ranges literally. `date` here is
  // parsed as UTC midnight (see conciertos.astro / conciertos.ics.ts), so we
  // do the +1 day math in UTC too, to avoid a local-timezone off-by-one.
  const gcalStart = toYYYYMMDD(date);
  const gcalEndDate = new Date(date);
  gcalEndDate.setUTCDate(gcalEndDate.getUTCDate() + 1);
  const gcalEnd = toYYYYMMDD(gcalEndDate);
  gcalDates = gcalStart + "/" + gcalEnd;
}

const gcalDetails = ticketUrl ? "Entradas: " + ticketUrl : "Legacy of the Seas en directo.";

const gcalParams = new URLSearchParams({
  action: "TEMPLATE",
  text: title,
  dates: gcalDates,
  location: [venue, city].filter(Boolean).join(", "),
  details: gcalDetails,
});
const googleCalendarEventUrl = "https://calendar.google.com/calendar/render?" + gcalParams.toString();
---

<article class={`bg-band-dark border rounded-lg overflow-hidden transition-all group ${isPast ? 'border-gray-700 opacity-60' : 'border-band-sea/20 hover:border-band-sea/50'}`}>
  <div class="flex flex-col sm:flex-row">
    <!-- Date block -->
    <div class={`flex-shrink-0 p-6 flex flex-col items-center justify-center sm:w-28 ${isPast ? 'bg-gray-800' : 'bg-band-dark-100'}`}>
      <span class={`text-3xl font-bold ${isPast ? 'text-gray-500' : 'text-band-sea'}`}>
        {dayNumber}
      </span>
      <span class={`text-sm uppercase tracking-wider ${isPast ? 'text-gray-600' : 'text-gray-400'}`}>
        {monthName}
      </span>
      <span class={`text-xs ${isPast ? 'text-gray-600' : 'text-gray-500'}`}>
        {date.getFullYear()}
      </span>
      {hasStartTime && (
        <span class={`text-xs ${isPast ? 'text-gray-600' : 'text-gray-500'}`}>
          {trimmedStartTime} h
        </span>
      )}
    </div>

    <!-- Content -->
    <div class="flex-1 p-6">
      <div class="flex flex-col sm:flex-row sm:items-center sm:justify-between gap-4">
        <div>
          <h3 class={`text-lg font-semibold mb-1 ${isPast ? 'text-gray-400' : 'text-white group-hover:text-band-sea'} transition-colors`}>
            {venue}
          </h3>
          <p class={`${isPast ? 'text-gray-600' : 'text-gray-400'}`}>
            {city}
          </p>
        </div>

        <!-- Action -->
        <div class="flex-shrink-0 flex flex-col items-start sm:items-end gap-2">
          {isPast ? (
            <span class="inline-block px-4 py-2 text-sm text-gray-500 uppercase tracking-wider">
              Pasado
            </span>
          ) : isSoldOut ? (
            <span class="inline-block px-4 py-2 bg-band-red/20 text-band-red text-sm font-semibold uppercase tracking-wider rounded">
              Agotado
            </span>
          ) : ticketUrl ? (
            <a
              href={ticketUrl}
              target="_blank"
              rel="noopener noreferrer"
              class="btn-primary inline-flex items-center gap-2 text-sm"
            >
              Entradas
              <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M10 6H6a2 2 0 00-2 2v10a2 2 0 002 2h10a2 2 0 002-2v-4M14 4h6m0 0v6m0-6L10 14"/>
              </svg>
            </a>
          ) : (
            <span class="inline-block px-4 py-2 text-sm text-gray-500 uppercase tracking-wider">
              Próximamente
            </span>
          )}

          {!isPast && id && (
            <div class="flex flex-col items-start sm:items-end gap-1">
              <a
                href={googleCalendarEventUrl}
                target="_blank"
                rel="noopener noreferrer"
                class="inline-flex items-center gap-1.5 text-xs text-band-sea hover:text-band-gold transition-colors"
              >
                <svg class="w-3.5 h-3.5" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                  <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M8 7V3m8 4V3m-9 8h10M5 21h14a2 2 0 002-2V7a2 2 0 00-2-2H5a2 2 0 00-2 2v12a2 2 0 002 2z" />
                </svg>
                Añadir a Google Calendar
              </a>
              <a
                href={`/conciertos/${id}.ics`}
                download
                class="inline-flex items-center gap-1.5 text-xs text-gray-600 hover:text-band-sea transition-colors"
              >
                Otras apps (.ics)
              </a>
            </div>
          )}
        </div>
      </div>

      {!isPast && bitEventId && (
        <div class="mt-2">
          <a
            class="bit-widget-initializer"
            data-artist-name={BIT_ARTIST_NAME}
            data-events-to-display={bitEventId}
            data-background-color="rgba(10,10,10,1)"
            data-separator-color="rgba(0,206,209,0.2)"
            data-text-color="rgba(0,206,209,1)"
            data-font="Inter"
            data-auto-style="true"
          >
          </a>
        </div>
      )}
    </div>
  </div>
</article>
