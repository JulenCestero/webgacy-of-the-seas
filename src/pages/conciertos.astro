---
import { createDb, concerts } from "../lib/db";
import { asc, desc, gte, lt } from "drizzle-orm";
import BaseLayout from "../layouts/BaseLayout.astro";
import ConcertCard from "../components/ConcertCard.astro";
import SocialLinks from "../components/SocialLinks.astro";
import { resolveEventInstants } from "../lib/ics";

// Get runtime env from Cloudflare
const runtimeEnv = Astro.locals.runtime?.env as Record<string, string> | undefined;
const db = createDb(runtimeEnv);

// Get current date in ISO format for comparison
const now = new Date().toISOString().split('T')[0];

// Calendar subscription links. Google Calendar has no "webcal://" click
// handler on Windows — it triggers the OS "choose an app" dialog, which
// most people cancel. Its own undocumented-but-widely-used shortcut
// (https://til.simonwillison.net/ics/google-calendar-ics-subscribe-link)
// takes a `cid=webcal://...` query param and drops the user straight into
// the "Subscribe to this calendar?" prompt inside Google Calendar itself —
// no OS dialog. That's the primary CTA; webcal:// and a plain https
// download are kept as a secondary option for Outlook/Apple/Thunderbird.
const icsFeedUrl = new URL("/conciertos.ics", Astro.site).toString();
const webcalFeedUrl = icsFeedUrl.replace(/^https:\/\//, "webcal://");
const googleCalendarSubscribeUrl = `https://calendar.google.com/calendar/render?cid=${encodeURIComponent(webcalFeedUrl)}`;

// Get upcoming concerts (date >= now) sorted ascending
const upcomingConcerts = await db.select().from(concerts)
  .where(gte(concerts.date, now))
  .orderBy(asc(concerts.date));

// Get past concerts (date < now) sorted descending (most recent first)
const pastConcerts = await db.select().from(concerts)
  .where(lt(concerts.date, now))
  .orderBy(desc(concerts.date));
// Generate MusicEvent schema for upcoming concerts.
//
// startDate/endDate con hora real cuando la hay: Google la usa para decidir si
// el evento sigue vigente y para mostrarla en la tarjeta. La conversión de
// hora-de-pared + IANA a instante absoluto vive en lib/ics.ts, compartida con
// el feed ICS para que el guard del DST no se bifurque.
const eventsSchema = upcomingConcerts.map(concert => {
  const { datePart, start, end } = resolveEventInstants(concert);
  return {
  "@type": "MusicEvent",
  "@id": new URL(`/conciertos#event-${concert.id}`, Astro.site).toString(),
  "name": concert.title,
  "startDate": start ? start.toISOString() : datePart,
  "endDate": end ? end.toISOString() : datePart,
  "eventStatus": "https://schema.org/EventScheduled",
  "eventAttendanceMode": "https://schema.org/OfflineEventAttendanceMode",
  "location": {
    "@type": "Place",
    "name": concert.venue,
    "address": {
      "@type": "PostalAddress",
      "addressLocality": concert.city
    }
  },
  "performer": {
    "@type": "MusicGroup",
    "name": "Legacy of the Seas"
  },
  // Sin `image` Google no da tarjeta enriquecida, solo texto. Se prefiere el
  // cartel del concierto (`concerts.image`, mismo patrón que tienda.astro:22) y
  // se cae a la og-image del sitio, que es genérica pero cumple.
  "url": new URL(`/conciertos#event-${concert.id}`, Astro.site).toString(),
  "image": new URL(concert.image || "/og-image.jpg", Astro.site).toString(),
  ...(concert.description ? { "description": concert.description } : {}),
  // No se emite `price`/`priceCurrency`: la tabla no guarda precio e inventarlo
  // sería falsear datos estructurados. Queda como aviso de campo recomendado.
  ...(concert.ticketUrl && !concert.isSoldOut ? {
    "offers": {
      "@type": "Offer",
      "url": concert.ticketUrl,
      "availability": "https://schema.org/InStock"
    }
  } : concert.isSoldOut ? {
    "offers": {
      "@type": "Offer",
      "availability": "https://schema.org/SoldOut",
      ...(concert.ticketUrl ? { "url": concert.ticketUrl } : {})
    }
  } : {})
  };
});

const schemaData = {
  "@context": "https://schema.org",
  "@graph": eventsSchema
};
---

<BaseLayout title="Conciertos" description="Próximos conciertos y fechas de la gira de Legacy of the Seas. Compra tus entradas y no te pierdas el directo.">
  {upcomingConcerts.length > 0 && (
    <script type="application/ld+json" set:html={JSON.stringify(schemaData)} />
  )}
  <!-- Hero section -->
  <section class="py-20 bg-band-dark-50">
    <div class="container mx-auto px-4 text-center">
      <h1 class="text-4xl md:text-6xl font-metal text-gradient mb-6">
        Conciertos
      </h1>
      <p class="text-xl text-gray-300 max-w-2xl mx-auto">
        Vive la experiencia Legacy of the Seas en directo.
        Consulta nuestras próximas fechas y consigue tus entradas.
      </p>
    </div>
  </section>

  <!-- Upcoming concerts -->
  <section class="py-16 bg-band-dark">
    <div class="container mx-auto px-4">
      <div class="flex flex-wrap items-start justify-between gap-4 mb-8">
        <h2 class="text-2xl md:text-3xl font-metal text-band-sea">
          Próximos Conciertos
        </h2>
        <div class="flex flex-col items-start sm:items-end gap-1.5">
          <a
            href={googleCalendarSubscribeUrl}
            target="_blank"
            rel="noopener noreferrer"
            title="Suscríbete y recibe todos los conciertos futuros automáticamente en Google Calendar"
            class="inline-flex items-center gap-2 text-sm text-band-sea hover:text-band-gold transition-colors font-medium"
          >
            <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24">
              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M8 7V3m8 4V3m-9 8h10M5 21h14a2 2 0 002-2V7a2 2 0 00-2-2H5a2 2 0 00-2 2v12a2 2 0 002 2z" />
            </svg>
            Suscribirse en Google Calendar
          </a>
          <div class="flex items-center gap-3 text-xs text-gray-500">
            <a
              href={webcalFeedUrl}
              title="Suscribirse con Outlook, Apple Calendar o Thunderbird"
              class="hover:text-band-sea transition-colors"
            >
              Otras apps (Outlook, Apple)
            </a>
            <span aria-hidden="true">·</span>
            <a
              href={icsFeedUrl}
              title="Descargar el archivo .ics con los próximos conciertos"
              class="hover:text-band-sea transition-colors"
            >
              Descargar .ics
            </a>
          </div>
        </div>
      </div>

      {upcomingConcerts.length > 0 ? (
        <div class="space-y-4 max-w-4xl">
          {upcomingConcerts.map((concert) => (
            <ConcertCard
              id={concert.id}
              title={concert.title}
              date={new Date(concert.date)}
              venue={concert.venue}
              city={concert.city}
              ticketUrl={concert.ticketUrl}
              isSoldOut={concert.isSoldOut}
              startTime={concert.startTime}
              timezone={concert.timezone}
            />
          ))}
        </div>
      ) : (
        <div class="bg-band-dark-100 border border-band-sea/20 rounded-lg p-8 text-center max-w-2xl">
          <p class="text-gray-400 mb-6">
            No hay conciertos programados por el momento.
            <br />
            ¡Síguenos en redes para estar al tanto de las novedades!
          </p>
          <SocialLinks size="md" className="justify-center" />
        </div>
      )}
    </div>
  </section>

  <!-- Past concerts -->
  {pastConcerts.length > 0 && (
    <section class="py-16 bg-band-dark-50">
      <div class="container mx-auto px-4">
        <h2 class="text-2xl md:text-3xl font-metal text-gray-500 mb-8">
          Conciertos Pasados
        </h2>

        <div class="space-y-4 max-w-4xl">
          {pastConcerts.map((concert) => (
            <ConcertCard
              title={concert.title}
              date={new Date(concert.date)}
              venue={concert.venue}
              city={concert.city}
              isSoldOut={concert.isSoldOut}
              isPast={true}
            />
          ))}
        </div>

        <p class="mt-8 text-gray-400">
          ¿Quieres revivir esas noches?
          <a href="/archivo" class="text-band-sea hover:text-band-gold transition-colors font-medium">
            Lee las crónicas en el Archivo
          </a>.
        </p>
      </div>
    </section>
  )}

  <!-- Newsletter CTA -->
  <section class="py-16 bg-band-dark">
    <div class="container mx-auto px-4 text-center">
      <div class="max-w-2xl mx-auto bg-band-dark-100 border border-band-sea/20 rounded-lg p-8">
        <h2 class="text-xl md:text-2xl font-metal text-band-sea mb-4">
          No te pierdas ninguna fecha
        </h2>
        <p class="text-gray-400 mb-6">
          Suscríbete para recibir notificaciones cuando anunciemos nuevos conciertos.
        </p>
        <a href="/contacto" class="btn-secondary inline-flex items-center gap-2">
          Contactar
          <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24">
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M17 8l4 4m0 0l-4 4m4-4H3"/>
          </svg>
        </a>
      </div>
    </div>
  </section>
</BaseLayout>
